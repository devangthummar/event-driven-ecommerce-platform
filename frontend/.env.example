# ============================================
# Frontend Environment Variables
# ============================================
# All VITE_ variables are exposed to the browser bundle and are PUBLIC.
# Never store secrets, API keys, or passwords here.

# API Base URL
# - Leave UNDEFINED for native development (Vite dev server proxy handles routing)
# - Set to "" (empty string) for Docker builds (Nginx reverse proxy handles routing)
# - Never set this to a Docker service name — those are internal infrastructure only
# VITE_API_BASE_URL=

# Base URL for the Product Service API (used only when VITE_API_BASE_URL is unset)
VITE_PRODUCT_SERVICE_URL=http://localhost:8081

# Base URL for the User Service API (used only when VITE_API_BASE_URL is unset)
VITE_USER_SERVICE_URL=http://localhost:8006

# Base URL for the Order Service API (used only when VITE_API_BASE_URL is unset)
VITE_ORDER_SERVICE_URL=http://localhost:8082
