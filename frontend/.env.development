# ============================================
# Development Environment
# ============================================
# These are PUBLIC frontend variables exposed to the browser.
# No secrets belong here.
#
# In native development mode, VITE_API_BASE_URL is intentionally NOT set.
# This causes the frontend to use direct backend URLs (localhost:8006/8081/8082)
# via the Vite dev server proxy defined in vite.config.js.
#
# In Docker mode, the Dockerfile sets VITE_API_BASE_URL="" so requests go
# through Nginx's reverse proxy instead.

VITE_PRODUCT_SERVICE_URL=http://localhost:8081
VITE_USER_SERVICE_URL=http://localhost:8006
VITE_ORDER_SERVICE_URL=http://localhost:8082
