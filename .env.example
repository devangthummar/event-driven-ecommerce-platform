# ============================================
# Production Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# Usage:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env up -d
#
# All secrets here are injected at runtime, never baked into images.

# ------------------------------------------
# PostgreSQL
# ------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_strong_password

# ------------------------------------------
# JWT Keys (RS256)
# ------------------------------------------
# The user-service requires the PRIVATE key to sign tokens.
# All other services require the PUBLIC key to validate tokens.
# Keys are mounted as read-only volumes from the ./keys/ directory.
# To generate new keys:
#   openssl genpkey -algorithm RSA -out keys/jwt-private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in keys/jwt-private.pem -out keys/jwt-public.pem
#
# NOTE: keys/jwt-private.pem and keys/jwt-public.pem must exist before starting.
# They are .gitignored and must be provisioned separately for each environment.

# ------------------------------------------
# Mail (Notification Service — optional)
# ------------------------------------------
# Leave empty to disable email sending in development.
# Set real SMTP credentials for production email delivery.
MAIL_USERNAME=
MAIL_PASSWORD=

# ------------------------------------------
# Frontend
# ------------------------------------------
# Host port for the frontend (default: 3000)
FRONTEND_PORT=3000
